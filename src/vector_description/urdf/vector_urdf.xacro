<?xml version="1.0" ?>
<robot name="vector_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find vector_description)/urdf/materials.xacro" />
  <xacro:include filename="$(find vector_description)/urdf/vector_urdf.gazebo" />

  <!-- ============================================================ -->
  <!-- ros2_control hardware interface (velocity-controlled wheels) -->
  <!-- ============================================================ -->
  <ros2_control name="vector_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="wheel_fl_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="wheel_fr_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="wheel_rl_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="wheel_rr_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <!-- ============================================================ -->
  <!-- Links                                                         -->
  <!-- ============================================================ -->

  <link name="base_link">
    <inertial>
      <origin xyz="-0.0016848158031269212 2.8878394275007632e-05 0.003183490932359" rpy="0 0 0"/>
      <mass value="1.7484518927526278"/>
      <inertia ixx="0.004168" iyy="0.008994" izz="0.013116" ixy="-3e-06" iyz="-0.0" ixz="3.5e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="motor_rr">
    <inertial>
      <origin xyz="-0.00795428894201243 0.017201148041795455 -0.018981594416767875" rpy="0 0 0"/>
      <mass value="0.21412983368070576"/>
      <inertia ixx="6.5e-05" iyy="1.9e-05" izz="6.2e-05" ixy="-0.0" iyz="2e-06" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.063875 0.079 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_rr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.063875 0.079 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_rr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_rr">
    <inertial>
      <origin xyz="-8.736069603831886e-09 -0.018209556043543462 -3.3649643280120323e-09" rpy="0 0 0"/>
      <mass value="0.27261016619768474"/>
      <inertia ixx="0.000119" iyy="0.0002" izz="0.000119" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.071875 0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_rr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.071875 0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_rr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="lidar_base">
    <inertial>
      <origin xyz="0.024238753126535242 0.02015993089846057 0.035063551600387745" rpy="0 0 0"/>
      <mass value="0.40855718259470825"/>
      <inertia ixx="0.000136" iyy="0.000332" izz="0.00041" ixy="-1e-06" iyz="1e-06" ixz="1e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.05 0.02 -0.025" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/lidar_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.05 0.02 -0.025" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/lidar_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0.0022301021944775984 0.00022500287625178015 0.006831231189608558" rpy="0 0 0"/>
      <mass value="0.17281948036952763"/>
      <inertia ixx="7.6e-05" iyy="7.5e-05" izz="0.000123" ixy="-2e-06" iyz="-0.0" ixz="-2e-06"/>
    </inertial>
    <visual>
      <origin xyz="-0.092 -0.0 -0.0732" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/lidar_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.092 -0.0 -0.0732" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/lidar_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="motor_fl">
    <inertial>
      <origin xyz="-0.008045711173699663 -0.017201147983939395 -0.01898159441676789" rpy="0 0 0"/>
      <mass value="0.21412983368070573"/>
      <inertia ixx="6.5e-05" iyy="1.9e-05" izz="6.2e-05" ixy="-0.0" iyz="-2e-06" ixz="-0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.079875 -0.079 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_fl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.079875 -0.079 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_fl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="motor_rl">
    <inertial>
      <origin xyz="-0.007905063164616283 -0.00220114770044489 -0.018981624995650415" rpy="0 0 0"/>
      <mass value="0.21412983368070687"/>
      <inertia ixx="6.5e-05" iyy="1.9e-05" izz="6.2e-05" ixy="0.0" iyz="-2e-06" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.063825 -0.064 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_rl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.063825 -0.064 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_rl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="motor_fr">
    <inertial>
      <origin xyz="-0.00809493715106191 0.002201147700444689 -0.018981624995650363" rpy="0 0 0"/>
      <mass value="0.21412983368070548"/>
      <inertia ixx="6.5e-05" iyy="1.9e-05" izz="6.2e-05" ixy="0.0" iyz="2e-06" ixz="-0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.079825 0.064 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_fr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.079825 0.064 -0.0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/motor_fr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_fl">
    <inertial>
      <origin xyz="8.736070269965701e-09 0.018209556043543434 -3.364964199642495e-09" rpy="0 0 0"/>
      <mass value="0.2726101661976888"/>
      <inertia ixx="0.000119" iyy="0.0002" izz="0.000119" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.071875 -0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_fl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.071875 -0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_fl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_rl">
    <inertial>
      <origin xyz="1.2999280862846518e-07 0.018209556043543212 -3.3649642412758585e-09" rpy="0 0 0"/>
      <mass value="0.2726101661977031"/>
      <inertia ixx="0.000119" iyy="0.0002" izz="0.000119" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.071776 -0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_rl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.071776 -0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_rl.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <link name="wheel_fr">
    <inertial>
      <origin xyz="-1.299928082676427e-07 -0.01820955604354338 -3.3649642482147524e-09" rpy="0 0 0"/>
      <mass value="0.27261016619768663"/>
      <inertia ixx="0.000119" iyy="0.0002" izz="0.000119" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
    </inertial>
    <visual>
      <origin xyz="-0.071776 0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_fr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.071776 0.089 0.019875" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://vector_description/meshes/wheel_fr.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- ============================================================ -->
  <!-- Joints                                                        -->
  <!-- ============================================================ -->

  <!-- base_link → motor_rr (fixed) -->
  <joint name="motor_rr_joint" type="fixed">
    <origin xyz="-0.063875 -0.079 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="motor_rr"/>
  </joint>

  <!-- motor_rr → wheel_rr (right-rear drive wheel) -->
  <joint name="wheel_rr_joint" type="continuous">
    <origin xyz="-0.008 -0.01 -0.019875" rpy="0 0 0"/>
    <parent link="motor_rr"/>
    <child link="wheel_rr"/>
    <axis xyz="0.0 -1.0 0.0"/>
  </joint>

  <!-- base_link → lidar_base (fixed) -->
  <joint name="lidar_base_joint" type="fixed">
    <origin xyz="0.05 -0.02 0.025" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_base"/>
  </joint>

  <!-- lidar_base → lidar_link (fixed) -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.042 0.02 0.0482" rpy="0 0 0"/>
    <parent link="lidar_base"/>
    <child link="lidar_link"/>
  </joint>

  <!-- base_link → motor_fl (fixed) -->
  <joint name="motor_fl_joint" type="fixed">
    <origin xyz="0.079875 0.079 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="motor_fl"/>
  </joint>

  <!-- base_link → motor_rl (fixed) -->
  <joint name="motor_rl_joint" type="fixed">
    <origin xyz="-0.063825 0.064 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="motor_rl"/>
  </joint>

  <!-- base_link → motor_fr (fixed) -->
  <joint name="motor_fr_joint" type="fixed">
    <origin xyz="0.079825 -0.064 0.0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="motor_fr"/>
  </joint>

  <!-- motor_fl → wheel_fl (left-front drive wheel) -->
  <joint name="wheel_fl_joint" type="continuous">
    <origin xyz="-0.008 0.01 -0.019875" rpy="0 0 0"/>
    <parent link="motor_fl"/>
    <child link="wheel_fl"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <!-- motor_rl → wheel_rl (left-rear drive wheel) -->
  <joint name="wheel_rl_joint" type="continuous">
    <origin xyz="-0.007951 0.025 -0.019875" rpy="0 0 0"/>
    <parent link="motor_rl"/>
    <child link="wheel_rl"/>
    <axis xyz="0.0 1.0 0.0"/>
  </joint>

  <!-- motor_fr → wheel_fr (right-front drive wheel) -->
  <joint name="wheel_fr_joint" type="continuous">
    <origin xyz="-0.008049 -0.025 -0.019875" rpy="0 0 0"/>
    <parent link="motor_fr"/>
    <child link="wheel_fr"/>
    <axis xyz="0.0 -1.0 0.0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- IMU link — massless, centred on base (TurtleBot3 pattern)   -->
  <!-- ============================================================ -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- base_link → imu_link: mounted at robot centre, 20 mm above base plane -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.0 0.0 0.02" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

</robot>
