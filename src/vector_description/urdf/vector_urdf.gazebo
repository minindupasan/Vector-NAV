<?xml version="1.0" ?>
<robot name="vector_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- gz_ros2_control plugin — loads diff_drive_controller via controller_manager -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find vector_description)/config/diff_drive_controller.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Base -->
  <gazebo reference="base_link">
    <material>Gazebo/Silver</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
    <gravity>true</gravity>
  </gazebo>

  <!-- ============================================================ -->
  <!-- IMU sensor — TurtleBot3 pattern (Ignition native, no plugin) -->
  <!-- MPU-6050 equivalent: 200 Hz, gyro stddev 2e-4, accel 1.7e-2 -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <sensor name="vector_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Motors (non-contacting, low friction) -->
  <gazebo reference="motor_fl">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="motor_fr">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="motor_rl">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="motor_rr">
    <material>Gazebo/DarkGrey</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- Wheels (high friction for traction) -->
  <gazebo reference="wheel_fl">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="wheel_fr">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="wheel_rl">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <selfCollide>false</selfCollide>
  </gazebo>

  <gazebo reference="wheel_rr">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- LiDAR mount -->
  <gazebo reference="lidar_base">
    <material>Gazebo/Silver</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>
  </gazebo>

  <!-- ============================================================ -->
  <!-- RPLidar A1M8 — TurtleBot3 pattern (Ignition native gpu_lidar)-->
  <!-- lidar_link is the rotating scan head                         -->
  <!-- ============================================================ -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Silver</material>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <selfCollide>false</selfCollide>

    <sensor name="rplidar_a1m8" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <!-- A1M8 nominal: ~5.5 Hz; 10 Hz for smoother simulation -->
      <update_rate>10</update_rate>
      <!-- Absolute topic — ros_gz_bridge picks this up directly as /scan -->
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>

      <lidar>
        <scan>
          <horizontal>
            <!-- 360 samples = 1° angular resolution (A1M8 spec) -->
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265358979</min_angle>
            <max_angle>3.14159265358979</max_angle>
          </horizontal>
        </scan>
        <range>
          <!-- A1M8: 0.15 m – 12 m -->
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <!-- ±1 cm matches A1M8 datasheet accuracy -->
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
