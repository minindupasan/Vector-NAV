<?xml version="1.0" ?>
<robot name="vector_urdf" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<!-- Dark green metallic for base_link -->
<material name="dark_green">
  <color rgba="0.08 0.22 0.08 1.0"/>
</material>

<!-- Dark grey metallic for motors, lidar base -->
<material name="dark_grey">
  <color rgba="0.18 0.18 0.20 1.0"/>
</material>

<!-- Near-black rubber for wheels -->
<material name="rubber_black">
  <color rgba="0.05 0.05 0.05 1.0"/>
</material>

<!-- Gunmetal for lidar head -->
<material name="gunmetal">
  <color rgba="0.15 0.15 0.18 1.0"/>
</material>

</robot>
