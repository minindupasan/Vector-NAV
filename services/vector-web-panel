# Allow vector-web service panel to control Vector Nav services without password
# Generated by vector_nav install.sh

admin ALL=(ALL) NOPASSWD: \
    /usr/bin/systemctl restart vector-web.service, \
    /usr/bin/systemctl stop vector-web.service, \
    /usr/bin/systemctl restart vector-llm.service, \
    /usr/bin/systemctl stop vector-llm.service, \
    /usr/bin/systemctl restart vector-assistant.service, \
    /usr/bin/systemctl stop vector-assistant.service, \
    /usr/bin/systemctl restart vector-navigation.service, \
    /usr/bin/systemctl stop vector-navigation.service, \
    /usr/bin/systemctl restart vector-status.service, \
    /usr/bin/systemctl stop vector-status.service, \
    /usr/bin/systemctl restart sllidar.service, \
    /usr/bin/systemctl stop sllidar.service, \
    /usr/sbin/poweroff, \
    /usr/sbin/reboot
