[Unit]
Description=Vector Nav — Assistant (LLM + Voice Pipeline)
Documentation=https://github.com/dusty-nv/jetson-containers
After=network-online.target docker.service vector-llm.service
Wants=network-online.target vector-llm.service
Requires=docker.service

[Service]
Type=simple
User=admin
Group=docker

EnvironmentFile=/home/admin/vector_nav/.env.local
Environment=HOME=/home/admin
Environment=XDG_RUNTIME_DIR=/run/user/1000

ExecStart=/home/admin/vector_nav/scripts/run_assistant.sh

# Give the ROS2 nodes time to shut down gracefully
TimeoutStopSec=30

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-assistant

[Install]
WantedBy=multi-user.target
