[Unit]
Description=Vector Nav — Status Manager (RPi + Jetson telemetry aggregator)
After=network-online.target vector-navigation.service
Wants=network-online.target
# Restart independently of vector-navigation so RPi data is re-fetched
# when the Pi comes online after the Jetson has already booted.

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/vector_nav
Environment=HOME=/home/admin
Environment=PATH=/home/admin/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/home/admin/vector_nav/.env.local

ExecStart=/home/admin/vector_nav/scripts/run_status.sh

TimeoutStartSec=60
TimeoutStopSec=15
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vector-status

[Install]
WantedBy=multi-user.target
