[Unit]
Description=VECTOR NAV — Raspberry Pi Camera (Docker)
After=docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/home/admin/vector_nav/docker/rpi
ExecStartPre=/usr/bin/docker compose -f docker-compose.camera.yaml down
ExecStart=/usr/bin/docker compose -f docker-compose.camera.yaml up
ExecStop=/usr/bin/docker compose -f docker-compose.camera.yaml down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
