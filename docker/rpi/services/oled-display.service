[Unit]
Description=VECTOR NAV — OLED status display (SSD1306)
After=battery.service docker.service network-online.target
Wants=battery.service network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/admin/vector_nav/docker/rpi/services/oled_display.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
