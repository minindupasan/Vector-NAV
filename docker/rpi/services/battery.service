[Unit]
Description=VECTOR NAV — Battery monitor (ADS1115)
After=multi-user.target

[Service]
Type=simple
RuntimeDirectory=vector
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/python3 /home/admin/vector_nav/docker/rpi/services/battery.py
Restart=on-failure
RestartSec=5
# Override Jetson IP via /etc/systemd/system/battery.service.d/override.conf
# Environment=JETSON_HOST=192.168.10.1
# Environment=SHUTDOWN_VOLTAGE=10.0

[Install]
WantedBy=multi-user.target
